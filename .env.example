# Environment Configuration Example for Frogeindrip Analytics Platform
# Copy this file to .env and configure as needed.

# OpenAI API Configuration (Optional: leaves platform in free, deterministic offline mode if blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DUCKDB_DATABASE_PATH=data/frogeindrip.duckdb

# Simulation & Seeding Settings
RANDOM_SEED=42
